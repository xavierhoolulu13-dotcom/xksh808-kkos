.ns-1d5nm-l-towerA { opacity: 0.01; position: absolute; top: 0px; left: 0px; display: block; width: 411px; height: 764px; }

.ns-1d5nm-e-0 { flex-shrink: 0; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; box-sizing: border-box; width: 100%; height: 100%; font-family: Roboto, Arial, sans-serif; display: flex; flex-direction: column; align-items: center; text-align: center; }

.ns-1d5nm-e-1 { display: block; max-height: 100%; max-width: 100%; width: 100%; }

.ns-1d5nm-e-2 { display: block; flex-shrink: 0; flex-grow: 0; width: 100%; max-width: 1200px; max-height: 267.4px; }

.ns-1d5nm-e-3 { box-sizing: border-box; flex-shrink: 0; height: 38.2px; }

.ns-1d5nm-e-4 { box-sizing: border-box; flex-shrink: 0; width: 100%; height: 382px; flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: space-between; }

.ns-1d5nm-e-5 { box-sizing: border-box; flex-shrink: 0; font-family: unset; font-weight: 700; width: 100%; line-height: 1.5em; max-height: 6em; border-style: solid; border-color: transparent; border-image: initial; border-width: 0px 41px; }

.ns-1d5nm-e-6, .ns-1d5nm-e-12 { }

.ns-1d5nm-e-7 { box-sizing: border-box; flex-shrink: 0; height: 30.56px; }

.ns-1d5nm-e-8 { display: block; max-height: 100%; max-width: 100%; }

.ns-1d5nm-e-9 { flex-shrink: 0; flex-grow: 0; height: 76.4px; max-height: 2143px; max-width: 369.9px; }

.ns-1d5nm-e-10 { box-sizing: border-box; flex-shrink: 0; height: 15.28px; }

.ns-1d5nm-e-11 { box-sizing: border-box; flex-shrink: 0; font-weight: 300; width: 100%; line-height: 1.8em; border-style: solid; border-color: transparent; border-image: initial; border-width: 0px 41px; }

.ns-1d5nm-e-13 { box-sizing: border-box; flex-shrink: 0; height: 22.92px; }

.ns-1d5nm-e-14 { max-height: 100%; max-width: 100%; }

.ns-1d5nm-e-15 { box-sizing: border-box; flex-shrink: 0; align-items: center; flex-direction: row; display: block; min-width: 25px; min-height: 25px; max-width: 56px; max-height: 56px; height: 76.4px; width: 76.4px; }

.ns-1d5nm-e-16 { flex-shrink: 0; flex-grow: 0; width: 100%; height: 100%; }

.ns-1d5nm-e-17 { box-sizing: border-box; flex-shrink: 0; height: 76.4px; }

.ns-1d5nm-v-0 .ns-1d5nm-e-0, .ns-1d5nm-v-0 .ns-1d5nm-e-11 { font-size: 20px; }

.ns-1d5nm-v-0 .ns-1d5nm-e-5 { font-size: 30px; }

.ns-1d5nm-v-0 .ns-1d5nm-e-7, .ns-1d5nm-v-0 .ns-1d5nm-e-9, .ns-1d5nm-v-0 .ns-1d5nm-e-14, .ns-1d5nm-v-0 .ns-1d5nm-e-17 { display: flex; }
