.btn-secondary:active { --tw-scale-x: 95%; --tw-scale-y: 95%; --tw-scale-z: 95%; scale: var(--tw-scale-x)var(--tw-scale-y); }

@media (prefers-color-scheme: dark) {
  @media (hover: hover) {
  .btn-secondary:hover { background-color: var(--color-gray-700); }
}
}

.btn-size-sm { padding-inline: calc(var(--spacing)*2); padding-block: calc(var(--spacing)*1); font-size: var(--text-xs); line-height: var(--tw-leading,var(--text-xs--line-height)); }

.btn-size-md { padding-inline: calc(var(--spacing)*3); padding-block: calc(var(--spacing)*2); font-size: var(--text-sm); line-height: var(--tw-leading,var(--text-sm--line-height)); }

.btn-size-lg { padding-inline: calc(var(--spacing)*4); padding-block: calc(var(--spacing)*3); font-size: var(--text-base); line-height: var(--tw-leading,var(--text-base--line-height)); }

.btn-full-width { width: 100%; }

.btn-uppercase { --tw-tracking: var(--tracking-wide); letter-spacing: var(--tracking-wide); text-transform: uppercase; }

.btn-toggle { cursor: pointer; border-style: var(--tw-border-style); border-width: 1px; border-color: var(--color-zinc-400); background-color: var(--color-zinc-200); padding-inline: calc(var(--spacing)*1.5); font-size: var(--text-xs); line-height: var(--tw-leading,var(--text-xs--line-height)); --tw-font-weight: var(--font-weight-medium); font-weight: var(--font-weight-medium); transition-property: all; transition-timing-function: var(--tw-ease,var(--default-transition-timing-function)); transition-duration: var(--tw-duration,var(--default-transition-duration)); user-select: none; justify-content: center; align-items: center; display: flex; }

@media (hover: hover) {
  .btn-toggle:hover { background-color: var(--color-gray-100); }
}

@media (prefers-color-scheme: dark) {
  .btn-toggle { border-color: var(--color-zinc-600); background-color: var(--color-zinc-800); }
  @media (hover: hover) {
  .btn-toggle:hover { background-color: var(--color-gray-700); }
}
}

.btn-toggle.active { border-color: var(--theme-colorTextSofter); background-color: var(--theme-colorCardC); }

@media (hover: hover) {
  .btn-toggle.active:hover { background-color: var(--theme-colorCardB); }
}

.btn-toggle input[type="checkbox"] { height: calc(var(--spacing)*4); width: calc(var(--spacing)*4); cursor: pointer; }

.settings-btn { cursor: pointer; justify-content: center; align-items: center; gap: calc(var(--spacing)*2); border-style: var(--tw-border-style); border-width: 1px; border-color: var(--theme-colorTextSofter); background-color: var(--color-zinc-100); padding-inline: calc(var(--spacing)*4); padding-block: calc(var(--spacing)*2); font-size: var(--text-xs); line-height: var(--tw-leading,var(--text-xs--line-height)); --tw-font-weight: var(--font-weight-medium); font-weight: var(--font-weight-medium); color: var(--theme-colorText); text-transform: uppercase; transition-property: all; transition-timing-function: var(--tw-ease,var(--default-transition-timing-function)); transition-duration: var(--tw-duration,var(--default-transition-duration)); display: flex; }

@media (prefers-color-scheme: dark) {
  .settings-btn { background-color: var(--color-zinc-700); }
}

.settings-btn:hover { border-color: var(--theme-colorText); background-color: var(--color-zinc-200); --tw-shadow: 0 4px 6px -1px var(--tw-shadow-color,#0000001a),0 2px 4px -2px var(--tw-shadow-color,#0000001a); box-shadow: var(--tw-inset-shadow),var(--tw-inset-ring-shadow),var(--tw-ring-offset-shadow),var(--tw-ring-shadow),var(--tw-shadow); }

@media (prefers-color-scheme: dark) {
  .settings-btn:hover { background-color: var(--color-zinc-800); }
}

.settings-btn:hover { transform: translateY(-1px); }

.settings-btn:active { --tw-shadow: 0 0 #0000; box-shadow: var(--tw-inset-shadow),var(--tw-inset-ring-shadow),var(--tw-ring-offset-shadow),var(--tw-ring-shadow),var(--tw-shadow); transform: translateY(0px); }

.settings-btn svg { width: 1.5rem; height: 1.5rem; transition: transform 0.15s ease-out; }

.settings-btn:hover svg { transform: scale(1.1); }

.showBtn { display: block; transform: translateY(0px); opacity: 1 !important; }

.menu-link { justify-content: center; gap: calc(var(--spacing)*2); padding: calc(var(--spacing)*2); color: var(--theme-colorText); display: flex; }

.menu-link:nth-child(2n+1) { background-color: var(--theme-colorCardA); }

.menu-link:nth-child(2n) { background-color: var(--theme-colorCardB); }

.only-md { display: none; }

@media (min-width: 30em) {
  .only-md { display: block; }
}

.divider { border-top-style: var(--tw-border-style); border-top-width: 1px; border-color: var(--theme-colorNeutral); }

.bevel { border-width: 2px; border-style: solid; border-image: initial; border-color: var(--theme-colorTextSoftest)var(--theme-colorTextSoft)var(--theme-colorTextSoft)var(--theme-colorTextSoftest); box-shadow: rgba(255, 255, 255, 0.3) 1px 1px inset, rgba(0, 0, 0, 0.2) -1px -1px inset, rgba(0, 0, 0, 0.1) 0px 2px 4px; }

