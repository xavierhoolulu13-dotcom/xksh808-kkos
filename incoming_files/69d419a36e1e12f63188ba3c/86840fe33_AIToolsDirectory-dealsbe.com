@charset "utf-8";

.ns-6c769-l-banner-nologo { display: block; }

.ns-oxfrk-l-square-eta-vanilla { display: none; }

@media (min-width: 406px) and (max-width: 416px) and (min-height: 377px) and (max-height: 387px) {
  .ns-6c769-l-banner-nologo { display: none; }
  .ns-oxfrk-l-square-eta-vanilla { display: block; }
}
