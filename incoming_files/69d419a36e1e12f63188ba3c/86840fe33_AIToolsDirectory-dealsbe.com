@charset "utf-8";

.ns-1d5nm-l-towerA { opacity: 1; position: relative; }

@keyframes slide-down { 
  0% { transform: translateY(-100%); filter: opacity(0%); }
  100% { transform: translateY(0%); filter: opacity(100%); }
}

@keyframes bounce { 
  0% { transform: translateY(-100%); filter: opacity(0%); }
  100% { transform: translateY(0%); filter: opacity(100%); }
}

@keyframes slide-in { 
  0% { transform: translateX(-100%); filter: opacity(0%); }
  100% { transform: translateX(0%); filter: opacity(100%); }
}

@keyframes slide-in-right { 
  0% { transform: translateX(100%); filter: opacity(0%); }
  100% { transform: translateX(0%); filter: opacity(100%); }
}

@keyframes fadein { 
  0% { filter: opacity(0%) blur(10px); }
  100% { filter: opacity(100%) blur(0px); }
}

@keyframes flash { 
  0% { transform: scale(2); filter: opacity(0%); }
  100% { transform: scale(1); filter: opacity(100%); }
}

@keyframes fadein_keyframes { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

.ns-1d5nm-e-0 { background-color: white; }

.ns-1d5nm-e-2 { background-image: url("https://tpc.googlesyndication.com/simgad/70881932696894104/14763004658117789537"); background-repeat: no-repeat; background-size: contain; animation: 0.9s ease 0s 1 normal both running fadein_keyframes; background-position: center center; }

.ns-1d5nm-e-6 { background-image: linear-gradient(0deg, rgb(255, 255, 255) 0%, transparent 0%); font-family: Roboto, Roboto, Arial, sans-serif; white-space: nowrap; }

.ns-1d5nm-e-9 { background-image: url("https://tpc.googlesyndication.com/simgad/2397359193117380968?w=200&h=200&tw=1&q=75"); background-repeat: no-repeat; animation: 0.9s ease 0s 1 normal both running fadein_keyframes; background-position: center center; background-color: transparent; background-size: contain; }

.ns-1d5nm-e-11 { color: rgb(92, 92, 92); }

.ns-1d5nm-e-12 { font-family: Roboto, Roboto, Arial, sans-serif; white-space: nowrap; }

.ns-1d5nm-e-14 { border-radius: 50%; }

.ns-1d5nm-e-15 { animation: 0.5s ease 0s 1 normal both running fadein_keyframes; box-shadow: rgba(0, 0, 0, 0.12) 0px 0px 2px 0px, rgba(0, 0, 0, 0.24) 0px 2px 2px 0px; text-shadow: rgba(255, 255, 255, 0.1) 1px 1px 0px; transform: rotate(45deg); border-radius: 50%; background-color: rgb(97, 97, 97); }

.ns-1d5nm-e-16 { background-repeat: no-repeat; transform: scale(0.36) translateX(-1px); }
