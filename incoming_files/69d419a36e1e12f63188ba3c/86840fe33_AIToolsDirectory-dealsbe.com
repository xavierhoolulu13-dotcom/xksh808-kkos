------MultipartBoundary--Zu5Wk8rGxQtdcIq7fdQtQzGAYkQggfHBgkyZG3mKjq----
Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: cid:css-bd3a1691-a721-4247-8734-1c0efbd0c80e@mhtml.blink

@charset "utf-8";

.ns-995jh-l-skyscraper-default { opacity: 1; position: relative; }

@keyframes frameScroll { 
  0%, 22% { transform: translateY(25%); }
  28%, 72% { transform: translateY(-25%); }
  78%, 100% { transform: translateY(25%); }
}

@keyframes frameFade1 { 
  0%, 22% { opacity: 1; }
  28%, 72% { opacity: 0; }
  78%, 100% { opacity: 1; }
}

@keyframes frameFade2 { 
  0%, 22% { opacity: 0; }
  28%, 72% { opacity: 1; }
  78%, 100% { opacity: 0; }
}

@keyframes slide-down { 
  0% { transform: translateY(-100%); filter: opacity(0%); }
  100% { transform: translateY(0%); filter: opacity(100%); }
}

@keyframes bounce { 
  0% { transform: translateY(-100%); filter: opacity(0%); }
  100% { transform: translateY(0%); filter: opacity(100%); }
}

@keyframes slide-in { 
  0% { transform: translateX(-100%); filter: opacity(0%); }
  100% { transform: translateX(0%); filter: opacity(100%); }
}

@keyframes slide-in-right { 
  0% { transform: translateX(100%); filter: opacity(0%); }
  100% { transform: translateX(0%); filter: opacity(100%); }
}

@keyframes fadein { 
  0% { filter: opacity(0%) blur(10px); }
  100% { filter: opacity(100%) blur(0px); }
}

@keyframes flash { 
  0% { transform: scale(2); filter: opacity(0%); }
  100% { transform: scale(1); filter: opacity(100%); }
}

.skyscraper-height-container { height: 61.12px; flex-grow: 0; justify-content: space-between; }

.bar-clickable-container { height: 61.12px; flex-grow: 0; }

.non-skyscraper-category .bar-clickable-container { height: 168.08px; }

@keyframes hide_button_animation { 
  0% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes show_button_animation { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes button_animation { 
  0% { background-color: rgb(255, 255, 255); color: rgb(72, 150, 250); }
  100% { background-color: rgb(72, 150, 250); color: rgb(255, 255, 255); }
}

@keyframes url_animation { 
  0% { color: rgba(0, 0, 0, 0.75); }
  100% { color: rgb(255, 255, 255); }
}

.viewport-entered .ns-995jh-l-skyscraper-default .common-animation-pattern.url-container { animation-name: url_animation; }

.viewport-entered .ns-995jh-l-skyscraper-default .common-animation-pattern.button-container { animation-name: button_animation; }

.viewport-entered .ns-995jh-l-skyscraper-default .common-animation-pattern.white-button { animation-name: hide_button_animation; }

.viewport-entered .ns-995jh-l-skyscraper-default .common-animation-pattern.highlight-button { animation-name: show_button_animation; }

.ns-995jh-l-skyscraper-default .common-animation-pattern { animation-duration: 0.25s; animation-fill-mode: both; animation-timing-function: ease-out; animation-delay: 1.8s; }

@media only screen and (prefers-reduced-motion), (hover: hover) {
  .skyscraper-height-container { flex-grow: 1; justify-content: flex-end; }
  .bar-clickable-container { height: 0px; }
  .non-skyscraper-category .bar-clickable-container { height: 0px; }
  .viewport-entered .ns-995jh-l-skyscraper-default .common-animation-pattern.url-container { animation-name: none; }
  .viewport-entered .ns-995jh-l-skyscraper-default .common-animation-pattern.button-container { animation-name: none; }
  .viewport-entered .ns-995jh-l-skyscraper-default .common-animation-pattern.white-button { animation-name: none; }
  .viewport-entered .ns-995jh-l-skyscraper-default .common-animation-pattern.highlight-button { animation-name: none; }
}

.ns-995jh-e-0 { background-color: rgb(255, 255, 255); }

.ns-995jh-e-3 { background-image: url("https://tpc.googlesyndication.com/simgad/14530604932505904980"); background-repeat: no-repeat; background-size: contain; }

.ns-995jh-e-4, .ns-995jh-e-29 { background-color: rgb(233, 233, 233); }

